{
	"name": "n8n-nodes-clickfunnel",
	"version": "1.1.2",
	"description": "n8n community node for ClickFunnels 2.0 — 52 resources, 200+ operations, webhook triggers. Built using the official ClickFunnels public API.",
	"license": "FUCL",
	"author": {
		"name": "Mirza Iqbal / next8n",
		"url": "https://next8n.com"
	},
	"homepage": "https://next8n.com",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"clickfunnels",
		"clickfunnels2",
		"funnels",
		"ecommerce",
		"crm",
		"automation"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"credentials": [
			"dist/credentials/ClickFunnelsApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/ClickFunnels/ClickFunnels.node.js",
			"dist/nodes/ClickFunnels/ClickFunnelsTrigger.node.js"
		]
	},
	"main": "index.js",
	"files": [
		"dist",
		"examples",
		"LICENSE"
	],
	"scripts": {
		"build": "tsc && gulp build:icons",
		"dev": "tsc --watch",
		"format": "prettier nodes credentials --write",
		"lint": "eslint nodes credentials --ext .ts",
		"test": "jest",
		"test:coverage": "jest --coverage",
		"prepublishOnly": "cp README.md README.dev.md && cp README.npm.md README.md && npm run build",
		"postpublish": "mv README.dev.md README.md"
	},
	"devDependencies": {
		"@types/jest": "^29.5.14",
		"@types/node": "^20.0.0",
		"gulp": "^4.0.2",
		"jest": "^29.7.0",
		"n8n-workflow": "^1.0.0",
		"prettier": "^3.0.0",
		"ts-jest": "^29.4.6",
		"typescript": "^5.0.0"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
