{
	"name": "n8n-nodes-clickfunnel",
	"version": "3.0.0",
	"description": "n8n community node for ClickFunnels 2.0. 52 resources, 210 operations and webhook triggers on the official ClickFunnels public API.",
	"license": "MIT",
	"author": {
		"name": "Mirza Iqbal",
		"email": "support@next8n.com",
		"url": "https://next8n.com"
	},
	"homepage": "https://next8n.com",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/mjmirza/n8n-nodes-clickfunnel.git"
	},
	"bugs": {
		"url": "https://github.com/mjmirza/n8n-nodes-clickfunnel/issues"
	},
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"clickfunnels",
		"clickfunnels2",
		"funnels",
		"ecommerce",
		"crm",
		"automation"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"credentials": [
			"dist/credentials/ClickFunnelsApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/ClickFunnels/ClickFunnels.node.js",
			"dist/nodes/ClickFunnels/ClickFunnelsTrigger.node.js"
		]
	},
	"main": "index.js",
	"files": [
		"dist",
		"LICENSE"
	],
	"scripts": {
		"build": "tsc && gulp build:icons",
		"prepack": "npm run build",
		"dev": "tsc --watch",
		"format": "prettier nodes credentials --write",
		"lint": "eslint --max-warnings 0 .",
		"test": "jest",
		"test:coverage": "jest --coverage",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@n8n/eslint-plugin-community-nodes": "^0.38.1",
		"@types/jest": "^30.0.0",
		"@types/node": "^24.19.2",
		"@typescript-eslint/parser": "8.70.0",
		"eslint": "9.29.0",
		"eslint-plugin-n8n-nodes-base": "^2.0.0",
		"gulp": "^5.0.1",
		"jest": "^30.5.2",
		"n8n-workflow": "~2.45.4",
		"prettier": "^3.9.10",
		"ts-jest": "^29.4.15",
		"typescript": "~6.0.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	}
}
